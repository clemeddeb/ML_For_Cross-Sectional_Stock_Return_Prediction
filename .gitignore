# Operating system files
.DS_Store

# Python caches and local environments
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/
env/
ENV/

# Jupyter notebooks are prohibited in the final submission
*.ipynb
*.nbconvert.ipynb
.ipynb_checkpoints/

# Testing, coverage, and editor caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.pyright/
.idea/
.vscode/

# Secrets and local config
.env
.env.*
!.env.example

# Logs, process files, and cluster/Run:AI artifacts
*.log
*.pid
*.out
*.err
outputs/logs/
runai/
runai*/
*runai*
*_job.log

# Local large CSV and generated processed data may be kept in the working tree,
# but the lightweight parquet rebuild inputs are preferred for git submission.
Dataset/Predictors/CompFirmCharac.csv
Dataset/Predictors/[usa]_[all_factors]_[monthly]_[vw_cap].csv
Dataset/Targets/monthly_crsp.csv
Dataset/Processed/*.parquet

# Temporary or debug artifacts
checkpoints/
output/
results/
outputs/sanity_checks/
outputs/figures/
outputs/**/__pycache__/
outputs/predictions/*debug*.parquet
outputs/models/deep_learning/temporal_tabular_debug*.pt
outputs/tables/*debug*

# Final artifacts intentionally kept in git:
# - outputs/predictions/*.parquet
# - outputs/models/**/*.pt, *.joblib, *.json
# - outputs/tables/*.csv and *.md
# - outputs/backtests/*.csv, *.md, and figures/*.png
